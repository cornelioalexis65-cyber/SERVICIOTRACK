# Puerto del servidor backend
PORT=3001

# Token de acceso. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y escríbelo en la app (Configuración > Copia de Seguridad > Conexión al servidor).
# Si se deja vacío, el servidor solo escucha en 127.0.0.1 y no pide token.
# API_TOKEN=

# Interfaz de red. Por defecto: 0.0.0.0 con token, 127.0.0.1 sin token.
# HOST=0.0.0.0

# Orígenes adicionales permitidos por CORS, separados por comas
# (los de desarrollo localhost:5173 y localhost:4173 ya están incluidos).
# CORS_ORIGINS=https://cornelioalexis65-cyber.github.io

# Configuración de base de datos (Opcional: si se omiten, utiliza SQLite local file:serviciotrack.db)
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu-token-aqui
