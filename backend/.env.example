# Puerto del servidor backend (solo en local; Vercel lo ignora)
PORT=3001

# Contraseña de acceso. Genera los dos valores con:
#   npm run hash-password
# En Vercel van en Settings > Environment Variables. Nunca los subas a git.
# Si se dejan vacíos, el servidor funciona en modo local: sin contraseña y
# solo accesible desde este equipo (127.0.0.1).
# APP_PASSWORD_HASH=scrypt:...:...
# SESSION_SECRET=

# Orígenes permitidos por CORS, separados por comas
# (los de desarrollo localhost:5173 y localhost:4173 ya están incluidos).
# CORS_ORIGINS=https://cornelioalexis65-cyber.github.io

# Base de datos (si se omite, usa el archivo local file:serviciotrack.db)
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu-token-aqui
